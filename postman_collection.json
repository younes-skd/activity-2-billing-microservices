{
  "info": {
    "name": "activity-2-billing-microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8880"
    }
  ],
  "item": [
    {
      "name": "Customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers"
      }
    },
    {
      "name": "Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Create bill",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bills",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"lines\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Bill details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bills/1"
      }
    }
  ]
}
